# API base URL (no trailing slash)
VITE_API_URL=http://localhost:3001

# WebSocket cable URL (omit /cable suffix — the app appends it)
VITE_CABLE_URL=ws://localhost:3001/cable

# Root app domain for subdomain detection
VITE_APP_DOMAIN=experthub.localhost

# Note: No Stripe or Razorpay publishable key is needed here — per-tenant keys come from the API.
# Stripe: POST /bookings returns payment.publishable_key and payment.client_secret.
# Razorpay: POST /bookings returns payment.key_id and payment.order_id.
